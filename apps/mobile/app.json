{
  "expo": {
    "name": "书灯",
    "slug": "shudeng-mobile",
    "scheme": "shudeng",
    "version": "0.4.8",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "buildNumber": "12",
      "bundleIdentifier": "dev.shudeng.mobile",
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.shudeng.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "onnxruntime-react-native",
      "expo-secure-store",
      "./plugins/withEpubResources.cjs",
      "./plugins/withReactNativeSource.cjs"
    ]
  }
}
