@@ -91,4 +91,41 @@ TEST(TextAttributesHashTest, identicalValuesInDifferentSlotsHashDifferently) {
       std::hash<TextAttributes>{}(pressable));
 }
 
+TEST(TextAttributesHashTest, lineSpacingDefaultsAndInheritance) {
+  TextAttributes parent;
+  EXPECT_TRUE(std::isnan(parent.lineSpacing));
+  parent.lineSpacing = 4;
+  parent.apply(TextAttributes{});
+  EXPECT_EQ(parent.lineSpacing, 4);
+
+  TextAttributes child;
+  child.lineSpacing = 0;
+  parent.apply(child);
+  EXPECT_EQ(parent.lineSpacing, 0);
+  child.lineSpacing = 6;
+  parent.apply(child);
+  EXPECT_EQ(parent.lineSpacing, 6);
+  for (Float invalid : {Float(-1), std::numeric_limits<Float>::infinity(),
+                        -std::numeric_limits<Float>::infinity(),
+                        std::numeric_limits<Float>::quiet_NaN()}) {
+    child.lineSpacing = invalid;
+    parent.apply(child);
+    EXPECT_EQ(parent.lineSpacing, 6);
+  }
+}
+
+TEST(TextAttributesHashTest, lineSpacingAffectsEqualityAndHash) {
+  TextAttributes baseline;
+  TextAttributes same;
+  EXPECT_EQ(baseline, same);
+  EXPECT_EQ(std::hash<TextAttributes>{}(baseline), std::hash<TextAttributes>{}(same));
+  TextAttributes spaced;
+  spaced.lineSpacing = 4;
+  EXPECT_FALSE(baseline == spaced);
+  EXPECT_NE(std::hash<TextAttributes>{}(baseline), std::hash<TextAttributes>{}(spaced));
+  same.lineSpacing = 4;
+  EXPECT_EQ(same, spaced);
+  EXPECT_EQ(std::hash<TextAttributes>{}(same), std::hash<TextAttributes>{}(spaced));
+}
+
 } // namespace facebook::react
