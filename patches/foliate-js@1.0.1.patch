diff --git a/bounded-viewport.js b/bounded-viewport.js
new file mode 100644
index 0000000..16c70d4
--- /dev/null
+++ b/bounded-viewport.js
@@ -0,0 +1,12 @@
+// Logical chapter coordinates stay independent of the physical iframe window.
+// Only horizontal LTR pagination opts in; callers retain the two sentinel pages.
+export const boundedViewport = (size, contentSize, position) => {
+    const width = Math.min(contentSize, size * 3)
+    const start = Math.max(0, Math.min(contentSize - width,
+        (Math.floor(position / size) - 2) * size))
+    return { width, start, left: size + start }
+}
+
+export const logicalRect = (rect, scrollX) => ({
+    ...rect, left: rect.left + scrollX, right: rect.right + scrollX,
+})
