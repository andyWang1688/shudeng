diff --git a/ios/RNSSheetDetentHeight.h b/ios/RNSSheetDetentHeight.h
new file mode 100644
--- /dev/null
+++ b/ios/RNSSheetDetentHeight.h
@@ -0,0 +1,21 @@
+#pragma once
+
+#ifdef __cplusplus
+#include <algorithm>
+#include <cmath>
+
+namespace rnscreens {
+
+// Keep the maximum detent and its index identifier unchanged when a reference
+// height is supplied. The resolver is also safe for callers bypassing JS.
+inline double resolveSheetDetentHeight(double maximumHeight, double fraction, double referenceHeight)
+{
+  if (fraction == 1.0) {
+    return maximumHeight;
+  }
+  const double baseHeight = std::isfinite(referenceHeight) && referenceHeight > 0 ? referenceHeight : maximumHeight;
+  return std::min(maximumHeight, baseHeight * fraction);
+}
+
+} // namespace rnscreens
+#endif // __cplusplus
